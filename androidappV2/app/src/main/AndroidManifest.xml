<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Network access for Firebase and device HTTP requests. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- requestNetwork(): talk to the ESP32 boards on DMS-NET (no internet) while Firebase uses mobile data. -->
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />

    <!-- Keep the CPU and Wi-Fi awake while monitoring runs with the screen off. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Check whether a network connection is available. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Show alerts and the ongoing monitoring notification -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Vibrate the phone for MEDIUM / HIGH alerts. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Keep the user-started monitoring session running in the background. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <!-- Required for the declared special-use foreground service on Android 14+. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- Application-wide configuration. Cleartext HTTP supports prototype devices. -->
    <application
        android:name=".DanteyeApp"
        android:allowBackup="false"
        android:usesCleartextTraffic="true"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.Danteye">

        <!-- The only launcher icon. Firebase role determines the destination. -->
        <activity android:name=".LauncherActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!-- Rotation keeps the current page (the screen rebuilds itself in onConfigurationChanged). -->
        <activity android:name=".MainActivity" android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden" />
        <activity android:name=".SupervisorActivity" android:exported="false" />
        <activity android:name=".SetupActivity" android:exported="false" />

        <!-- Internal settings screen, opened from within the app. -->
        <activity android:name=".SettingsActivity" android:exported="false"/>
        <activity android:name=".GuidedRecordingActivity" android:exported="false"
            android:label="Guided recording" android:screenOrientation="portrait"/>

        <!-- Share session logs (History tab) as a .zip -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- User-started foreground service: the detection program (ESP32-CAM video over Wi-Fi), alerts, break reminders. -->
        <service android:name=".DriverMonitoringService" android:exported="false"
            android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="User-started driver monitoring: analyses the ESP32 camera video over Wi-Fi, sounds safety alerts and gives two-hour break reminders" />
        </service>

        <!-- Receive Firebase Cloud Messaging alerts -->
        <service android:name=".AlertMessagingService" android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT"/>
            </intent-filter>
        </service>
    </application>
</manifest>
